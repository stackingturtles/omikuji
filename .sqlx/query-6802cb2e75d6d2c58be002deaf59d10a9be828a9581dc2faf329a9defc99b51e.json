{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                id,\n                transaction_hash,\n                log_index,\n                contract_address,\n                event_type,\n                processed_at AT TIME ZONE 'UTC' as \"processed_at!\",\n                event_data\n            FROM omikuji.processed_events\n            WHERE contract_address = $1\n            ORDER BY processed_at DESC\n            LIMIT $2\n            ",
