#!/bin/sh
# Pre-commit hook to check Rust formatting and linting

set -e

# Check if cargo is available
if ! command -v cargo >/dev/null 2>&1; then
    echo "cargo not found, skipping checks"
    exit 0
fi

# Check formatting
echo "Checking code formatting..."
if ! cargo fmt -- --check 2>/dev/null; then
    echo ""
    echo "ERROR: Code is not formatted correctly."
    echo "Run 'cargo fmt' to fix formatting issues."
    echo ""
    exit 1
fi
echo "Formatting check passed."

# Run clippy linter
echo "Running clippy linter..."
if ! SQLX_OFFLINE=true cargo clippy --quiet -- -D warnings -D clippy::uninlined_format_args 2>/dev/null; then
    echo ""
    echo "ERROR: Clippy found issues."
    echo "Run 'cargo clippy -- -D warnings -D clippy::uninlined_format_args' to see details."
    echo ""
    exit 1
fi
echo "Clippy check passed."

echo ""
echo "All pre-commit checks passed!"
exit 0
